<Window x:Class="MyQrCodeScanner.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyQrCodeScanner.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:MyQrCodeScanner.Converters"
        Title="{DynamicResource Settings}"
        Width="900" Height="760"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource MaterialDesignPaper}"
        Icon="/Resources/logo.ico" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontSize="14"
        mc:Ignorable="d">
    <Grid>
        <TabControl materialDesign:ColorZoneAssist.Mode="PrimaryDark"
                    Style="{StaticResource MaterialDesignFilledTabControl}"
                    TabStripPlacement="Left">
            <TabItem Header="{DynamicResource FunctionSettings}">
                <StackPanel Margin="10,5,5,0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TextAutoRun"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,0"
                                   Text="{DynamicResource AutoRun}"
                                   FontSize="14" />
                        <ToggleButton x:Name="ToggleAutoRun"
                                      VerticalAlignment="Center"
                                      Margin="8,3"
                                      IsChecked="{Binding IsAutoRun}"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </StackPanel>
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{DynamicResource SoundHint}"
                                   FontSize="14" />
                        <TextBlock VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Text="{DynamicResource SoundSuccess}"
                                   FontSize="14" />
                        <ToggleButton VerticalAlignment="Center"
                                      Margin="8,3"
                                      IsChecked="{Binding PlaySoundSuccess}"
                                      AutomationProperties.AutomationId="PlaySoundSuccessToggle"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                        <TextBlock VerticalAlignment="Center"
                                   Margin="20,0,0,0"
                                   Text="{DynamicResource SoundMatched}"
                                   FontSize="14" />
                        <ToggleButton VerticalAlignment="Center"
                                      Margin="8,3"
                                      IsChecked="{Binding PlaySoundMatched}"
                                      AutomationProperties.AutomationId="PlaySoundMatchedToggle"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </StackPanel>
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,0,0"
                                   Text="{DynamicResource MiniToTray}"
                                   FontSize="14" />
                        <ToggleButton x:Name="ToggleHideToTray"
                                      VerticalAlignment="Center"
                                      Margin="8,3"
                                      IsChecked="{Binding HideToTray}"
                                      AutomationProperties.AutomationId="HideToTrayToggle"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </StackPanel>
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,0,0"
                                   Text="{DynamicResource IgnoreSame}"
                                   FontSize="14" />
                        <ToggleButton VerticalAlignment="Center"
                                      Margin="8,3"
                                      IsChecked="{Binding IgnoreDup}"
                                      AutomationProperties.AutomationId="IgnoreDupToggle"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </StackPanel>
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <StackPanel.Resources>
                            <converters:BoolToInverseBoolConverter x:Key="BoolToInverseBoolConverter" />
                        </StackPanel.Resources>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{DynamicResource CaptureMode}"
                                   FontSize="14" />
                        <RadioButton IsChecked="{Binding CaptureMode}" VerticalContentAlignment="Center">
                            <TextBlock Text="{DynamicResource FullScreen}" />
                        </RadioButton>
                        <RadioButton Margin="10,0,0,0"
                                     IsChecked="{Binding CaptureMode, Converter={StaticResource BoolToInverseBoolConverter}}"
                                     VerticalContentAlignment="Center">
                            <TextBlock Text="{DynamicResource ScreenRect}" />
                        </RadioButton>
                    </StackPanel>
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,0,0"
                                   Text="{DynamicResource FastMode}"
                                   FontSize="14" />
                        <ToggleButton VerticalAlignment="Center"
                                      Margin="8,3"
                                      IsChecked="{Binding FastCaptureMode}"
                                      AutomationProperties.AutomationId="FastCaptureToggle"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </StackPanel>
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,0,0"
                                   Text="{DynamicResource InputEnter}"
                                   FontSize="14" />
                        <ToggleButton VerticalAlignment="Center"
                                      Margin="8,3"
                                      IsChecked="{Binding IsInputEnter}"
                                      AutomationProperties.AutomationId="InputEnterToggle"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{DynamicResource CaptureHotKey}"
                                   FontSize="14" />
                        <ComboBox Width="60"
                                  Margin="10,0,0,0"
                                  IsEditable="False" SelectedIndex="0"
                                  ItemsSource="{Binding KeyTypes}"
                                  SelectedItem="{Binding SelectedKeyType}"
                                  FontSize="12" />
                        <TextBlock VerticalAlignment="Center"
                                   Margin="10,0"
                                   Text="+"
                                   FontSize="18" />
                        <ComboBox Width="70"
                                  SelectedIndex="0" IsEditable="False"
                                  ItemsSource="{Binding Keys}"
                                  SelectedItem="{Binding SelectedKey}"
                                  FontSize="12" />
                        <Button Margin="10,0"
                                Content="{DynamicResource Apply}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="Save_Click" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="{DynamicResource UISettings}">
                <Grid Margin="10,5,5,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,0,0"
                                   Text="{DynamicResource BackAnimation}"
                                   FontSize="14" />
                        <ToggleButton VerticalAlignment="Center"
                                      Margin="8,3"
                                      IsChecked="{Binding IsStarOn}"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </StackPanel>
                    <StackPanel Margin="0,5"
                                Grid.Row="1"
                                Orientation="Horizontal">
                        <StackPanel.Resources>
                            <converters:BoolToInverseBoolConverter x:Key="BoolToInverseBoolConverter" />
                        </StackPanel.Resources>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{DynamicResource Theme}"
                                   FontSize="14" />
                        <RadioButton IsChecked="{Binding IsDark}" VerticalContentAlignment="Center">
                            <TextBlock Text="{DynamicResource DarkTheme}" />
                        </RadioButton>
                        <RadioButton Margin="10,0,0,0"
                                     IsChecked="{Binding IsDark, Converter={StaticResource BoolToInverseBoolConverter}}"
                                     VerticalContentAlignment="Center">
                            <TextBlock Text="{DynamicResource LightTheme}" />
                        </RadioButton>
                    </StackPanel>
                    <StackPanel Margin="0,5"
                                Grid.Row="2"
                                Orientation="Horizontal">
                        <StackPanel.Resources>
                            <converters:BoolToInverseBoolConverter x:Key="BoolToInverseBoolConverter" />
                        </StackPanel.Resources>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{DynamicResource Language}"
                                   FontSize="14" />
                        <RadioButton IsChecked="{Binding IsChinese}" VerticalContentAlignment="Center">
                            <TextBlock Text="{DynamicResource Chinese}" />
                        </RadioButton>
                        <RadioButton Margin="10,0,0,0"
                                     IsChecked="{Binding IsChinese, Converter={StaticResource BoolToInverseBoolConverter}}"
                                     VerticalContentAlignment="Center">
                            <TextBlock Text="{DynamicResource English}" />
                        </RadioButton>
                    </StackPanel>
                    <ScrollViewer Grid.Row="3"
                                  FocusVisualStyle="{x:Null}"
                                  DataContext="{Binding PaletteVm}">
                        <ItemsControl Margin="0,2,0,0"
                                      ItemsSource="{Binding Styles}"
                                      ItemTemplate="{StaticResource PaletteListItemStyle}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="14" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource PostProcessSettings}">
                <Grid Margin="12,6,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{DynamicResource PostProcessModesLabel}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding PostProcessModes}"
                                      Margin="0,5,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding ModeName}"
                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="{Binding Mode, StringFormat=PostProcessModeEnabled_{0}}"
                                              Margin="0,0,24,6"
                                              FontSize="13" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource PostProcessRulesLabel}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource PostProcessRulesHint}"
                                       Margin="0,3,12,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{DynamicResource AddRule}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="30"
                                Padding="12,0"
                                VerticalAlignment="Top"
                                Click="AddRule_Click" />
                    </Grid>

                    <ScrollViewer x:Name="PostProcessRuleScroll"
                                  Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <ItemsControl ItemsSource="{Binding PostProcessRules}"
                                      HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,6,10"
                                            Padding="12"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            CornerRadius="4">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text=":"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Margin="1,0,8,0"
                                                           VerticalAlignment="Center" />
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.AutomationId="{Binding Number, StringFormat=PostProcessName_{0}}"
                                                         InputMethod.IsInputMethodEnabled="True"
                                                         Height="28"
                                                         Margin="0,0,12,0"
                                                         Padding="6,2"
                                                         VerticalContentAlignment="Center"
                                                         Background="{DynamicResource MaterialDesignPaper}"
                                                         Foreground="{DynamicResource MaterialDesignBody}"
                                                         BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                         BorderThickness="1"
                                                         CaretBrush="{DynamicResource MaterialDesignBody}"
                                                         FontSize="13" />
                                                <Button Grid.Column="3"
                                                        Content="{DynamicResource DeleteRule}"
                                                        HorizontalAlignment="Right"
                                                        Height="26"
                                                        Padding="8,0"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Click="DeleteRule_Click" />
                                            </Grid>

                                            <TextBlock Text="{DynamicResource PostProcessPatternHint}"
                                                       Margin="0,9,0,5"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="/"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Margin="0,0,6,0" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.AutomationId="{Binding Number, StringFormat=PostProcessPattern_{0}}"
                                                         InputMethod.IsInputMethodEnabled="True"
                                                         IsReadOnly="False"
                                                         PreviewMouseLeftButtonDown="RegexBox_PreviewMouseLeftButtonDown"
                                                         PreviewKeyDown="RegexBox_PreviewKeyDown"
                                                         Height="36"
                                                         Padding="8,4"
                                                         Background="{DynamicResource MaterialDesignPaper}"
                                                         Foreground="{DynamicResource MaterialDesignBody}"
                                                         BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                         BorderThickness="1"
                                                         CaretBrush="{DynamicResource MaterialDesignBody}"
                                                         VerticalContentAlignment="Center"
                                                         FontFamily="Consolas"
                                                         FontSize="14" />
                                                <TextBlock Grid.Column="2"
                                                           Text="/g"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Margin="6,0,0,0" />
                                                <Button Grid.Column="3"
                                                        Content="{DynamicResource PasteFromClipboard}"
                                                        AutomationProperties.AutomationId="{Binding Number, StringFormat=PostProcessPaste_{0}}"
                                                        Height="36"
                                                        Margin="8,0,0,0"
                                                        Padding="10,0"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Click="PastePattern_Click" />
                                            </Grid>

                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <TextBlock Text="{DynamicResource PostProcessMatchLabel}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <TextBox Width="72"
                                                                 Height="34"
                                                                 Padding="4,2"
                                                                 Text="{Binding MatchIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.AutomationId="{Binding Number, StringFormat=PostProcessMatch_{0}}"
                                                                 InputMethod.IsInputMethodEnabled="False"
                                                                 IsReadOnly="False"
                                                                 PreviewMouseLeftButtonDown="RegexBox_PreviewMouseLeftButtonDown"
                                                                 PreviewKeyDown="RegexBox_PreviewKeyDown"
                                                                 Background="{DynamicResource MaterialDesignPaper}"
                                                                 Foreground="{DynamicResource MaterialDesignBody}"
                                                                 BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                                 BorderThickness="1"
                                                                 CaretBrush="{DynamicResource MaterialDesignBody}"
                                                                 VerticalContentAlignment="Center"
                                                                 HorizontalContentAlignment="Center" />
                                                        <TextBlock Text="{DynamicResource PostProcessMatchSuffix}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0,0,0"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{DynamicResource PostProcessGroupLabel}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <TextBox Width="72"
                                                                 Height="34"
                                                                 Padding="4,2"
                                                                 Text="{Binding GroupIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.AutomationId="{Binding Number, StringFormat=PostProcessGroup_{0}}"
                                                                 InputMethod.IsInputMethodEnabled="False"
                                                                 IsReadOnly="False"
                                                                 PreviewMouseLeftButtonDown="RegexBox_PreviewMouseLeftButtonDown"
                                                                 PreviewKeyDown="RegexBox_PreviewKeyDown"
                                                                 Background="{DynamicResource MaterialDesignPaper}"
                                                                 Foreground="{DynamicResource MaterialDesignBody}"
                                                                 BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                                 BorderThickness="1"
                                                                 CaretBrush="{DynamicResource MaterialDesignBody}"
                                                                 VerticalContentAlignment="Center"
                                                                 HorizontalContentAlignment="Center" />
                                                        <TextBlock Text="{DynamicResource PostProcessGroupSuffix}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0,0,0"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0">
                        <TextBlock x:Name="PostProcessStatus"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                        <Button x:Name="PostProcessApplyButton"
                                Content="{DynamicResource Apply}"
                                AutomationProperties.AutomationId="PostProcessApply"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="PostProcessApply_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
